# Large pretrained model snapshots are downloaded at immutable revisions.
# The two small, hash-pinned policy heads remain tracked for clone-ready use.
models/*.joblib
!models/vit_policy_head.joblib
!models/resnet50_policy_head.joblib
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors

# The complete 288-image formal dataset remains in the local canonical checkout.
# These 216 third-party images stay outside public Git history until their
# redistribution rights and item-level provenance are cleared.
data/capstone_dataset/*/safe/
data/capstone_dataset/*/firearms/
data/capstone_dataset/*/explosives/

# Manual review found this Commons search-result image irrelevant to the
# explosives diagnostic. Its registry row remains as an auditable exclusion.
data/wikimedia_pilot/train/explosives/explosives_train_7c750c3977f9.jpg

# Generated book copies and build trees are reproducible from the root notebook.
book/_build/
book/ad_safety_moderation_pipeline.ipynb
*.ipynb_checkpoints/

# The historical starter is superseded by the executed root notebook.
archive/

# Final deliverables and canonical evidence under outputs/ are tracked. Only
# reproducible intermediates, duplicate encodings, and temporary QA renders
# are excluded.
outputs/presentation/.build/
outputs/presentation/rendered/
outputs/presentation/rendered_pptx/
outputs/presentation/*.inspect.ndjson
outputs/presentation/deck_montage.webp
outputs/presentation/reopened_montage.webp
outputs/presentation/grid_selection.json
outputs/presentation/.Rhistory
outputs/report/rendered/
